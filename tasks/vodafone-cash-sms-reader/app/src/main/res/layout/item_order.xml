<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Row 1: Order number + status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/orderIdText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="طلب #—"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:alpha="0.7" />

            <TextView
                android:id="@+id/orderStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="قيد المراجعة"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                app:cardCornerRadius="6dp" />
        </LinearLayout>

        <!-- Row 2: Amount (big) -->
        <TextView
            android:id="@+id/orderAmountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00 جنيه"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <!-- Row 3: Credits requested -->
        <TextView
            android:id="@+id/orderCreditsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:alpha="0.75"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Row 4: Customer info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 "
                android:textSize="12sp" />

            <TextView
                android:id="@+id/orderCustomerPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉️ "
                android:textSize="12sp" />

            <TextView
                android:id="@+id/orderCustomerEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="12sp"
                android:alpha="0.7" />
        </LinearLayout>

        <!-- Row 5: Payment method + date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/orderPaymentMethod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="12sp"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/orderCreatedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="12sp"
                android:alpha="0.6" />
        </LinearLayout>

        <!-- Failure reason -->
        <TextView
            android:id="@+id/orderFailureReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#EF4444"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Transaction ID -->
        <TextView
            android:id="@+id/orderTxId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:alpha="0.7"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <!-- Scan status progress -->
        <TextView
            android:id="@+id/orderScanProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#3B82F6"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Divider before actions -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:id="@+id/actionDivider"
            android:visibility="gone" />

        <!-- Action buttons -->
        <LinearLayout
            android:id="@+id/actionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="end">

            <Button
                android:id="@+id/btnRescan"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="إعادة فحص"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnConfirmManual"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="تأكيد يدوي"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>

