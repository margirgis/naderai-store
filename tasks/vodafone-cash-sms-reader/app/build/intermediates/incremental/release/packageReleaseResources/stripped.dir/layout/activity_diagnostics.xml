<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 تشخيصات النظام"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الأرقام دي بتقولك إذا كان التطبيق بيفحص فعلاً ولا لا."
            android:textSize="13sp"
            android:alpha="0.7"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="صلاحيات الرسائل"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/statusPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تجاهل تحسين البطارية"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/statusBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="خدمة الفحص"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/statusService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="طلبات قيد الانتظار"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/statusPendingOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آخر فحص"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/statusLastScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حالة الاتصال بالسيرفر"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/statusConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 تحديث" />

        <Button
            android:id="@+id/btnOpenSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="افتح إعدادات التطبيق" />

        <TextView
            android:id="@+id/diagnosticText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
